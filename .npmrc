# Cooldown: npm resolves only versions published more than 3 days ago, so a compromised release is usually pulled before it
# reaches the lockfile (npm 11.10 and later; older npm warns about an unknown key and ignores it). npm ci and npm install from
# the committed lockfile are not affected. To take a version younger than that on purpose (your own release, a security fix),
# pass --min-release-age=0 on that one command and say why in the commit message.
min-release-age=3
